<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="OopFactory.X12" Version="3.0.8.1" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="SkiaSharp.Views.WindowsForms" Version="3.119.4" />
	</ItemGroup>

	<ItemGroup>
		<None Update="850_POMultiline.xml">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="850_POMultiline.xsd">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="BuiltInFunctoids.xml"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
		<None Update="DestinationUser.xml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
		<None Update="outputSchema.xml">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\Settings.settings">
		  <Generator>SettingsSingleFileGenerator</Generator>
		  <LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
		<None Update="SourceProfile.xml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
		<None Update="yy.xml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="SkiaMapper.Tests\**\*.cs" />
		<Content Remove="SkiaMapper.Tests\**\*" />
		<EmbeddedResource Remove="SkiaMapper.Tests\**\*" />
		<None Remove="SkiaMapper.Tests\**\*" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

</Project>